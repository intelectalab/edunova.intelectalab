{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "desarrollo": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "desarrollo",
      "env": { "EXPO_PUBLIC_API_URL": "http://10.0.2.2:8000/api/v1" }
    },
    "pruebas": {
      "distribution": "internal",
      "channel": "pruebas",
      "env": { "EXPO_PUBLIC_API_URL": "https://edunova.intelectalab.com/api/v1" },
      "android": { "buildType": "apk" }
    },
    "produccion": {
      "channel": "produccion",
      "autoIncrement": true
    }
  },
  "submit": {
    "produccion": {
      "android": { "track": "internal", "releaseStatus": "draft" },
      "ios": {}
    }
  }
}
