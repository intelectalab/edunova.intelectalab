{
  "expo": {
    "name": "Edunova",
    "slug": "edunova",
    "scheme": "edunova",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "pe.edunova.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para que vuelvas a entrar a Edunova sin escribir tu contraseña."
      },
      "supportsTablet": false
    },
    "android": {
      "package": "pe.edunova.app",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos Face ID para que vuelvas a entrar a Edunova sin escribir tu contraseña."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#047857"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos la cámara para leer el código QR del carné en la puerta."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Compartimos la ubicación de la movilidad con las familias solo mientras el recorrido está en curso."
        }
      ],
      "expo-updates"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
