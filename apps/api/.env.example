APP_NAME=Edunova
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100
APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=edunova
DB_USERNAME=edunova_app
DB_PASSWORD=edunova_app
DB_PROPIETARIO_USERNAME=edunova
DB_PROPIETARIO_PASSWORD=edunova
DB_PLATAFORMA_USERNAME=edunova_plataforma
DB_PLATAFORMA_PASSWORD=edunova_plataforma

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@edunova.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=edunova
AWS_SECRET_ACCESS_KEY=edunova-secreto
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=edunova
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://s3:8333
# Host de las URL firmadas que ve el navegador (el puerto 9000 publica el S3 local)
AWS_URL_FIRMAS=http://localhost:9000
EDUNOVA_ARCHIVOS_MAX_MB=10

VITE_APP_NAME="${APP_NAME}"

# EDUN-208 · Secreto del webhook de rebotes y quejas (en la nube, del gestor de secretos)
CORREO_WEBHOOK_SECRETO=

# EDUN-233 · Revalidación del sitio al publicar (URL del sitio Next.js y secreto compartido)
SITIO_REVALIDAR_URL=http://host.docker.internal:3000/api/revalidar
SITIO_REVALIDAR_SECRETO=
SITIO_PROXY_SECRETO=

# EDUN-237 · Medios del sitio (bucket público) y su URL pública
AWS_BUCKET_SITIO=edunova-sitio
AWS_URL_SITIO=http://localhost:9000/edunova-sitio

# EDUN-209 · Orígenes permitidos (web de gestión, sitio y apps), separados por comas
CORS_ORIGENES=http://localhost:5174,http://localhost:3000
